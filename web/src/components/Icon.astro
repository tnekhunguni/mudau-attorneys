---
// Small inline icon set (stroke icons, 24px grid). Decorative by default.
interface Props { name: 'phone' | 'whatsapp' | 'pin' | 'mail' | 'menu' | 'close' | 'chevron' | 'download'; label?: string }
const { name, label } = Astro.props;
const paths: Record<string, string> = {
  phone: '<path d="M5 3h3.2l1.6 4.4-2.2 1.4a12 12 0 0 0 7.6 7.6l1.4-2.2L21 15.8V19a2 2 0 0 1-2 2A17 17 0 0 1 3 5a2 2 0 0 1 2-2Z"/>',
  whatsapp: '<path d="M4 20l1.3-3.8A8.5 8.5 0 1 1 8 19l-4 1Z"/><path d="M9 8.6c.2-.6.6-.7 1-.6l.8 1.8-.6.9a6 6 0 0 0 3 3l.9-.6 1.8.8c.1.4 0 .8-.6 1-1 .5-2.6.1-4.3-1.4C9.4 12 8.6 9.9 9 8.6Z"/>',
  pin: '<path d="M12 21s-7-6.1-7-11.5a7 7 0 0 1 14 0C19 14.9 12 21 12 21Z"/><circle cx="12" cy="9.5" r="2.5"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="1"/><path d="m3.5 6 8.5 7 8.5-7"/>',
  menu: '<path d="M3 7h18M3 12h18M3 17h18"/>',
  close: '<path d="M5 5l14 14M19 5 5 19"/>',
  chevron: '<path d="m9 5 7 7-7 7"/>',
  download: '<path d="M12 4v11m0 0-4.5-4.5M12 15l4.5-4.5M5 20h14"/>',
};
---
<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  set:html={paths[name]}
/>
