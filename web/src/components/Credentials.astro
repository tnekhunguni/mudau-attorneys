---
// Credentials and client names. Designed for the black section.
import { credentials, clients } from '../data/site';
---
<dl class="creds">
  {credentials.map((c) => (
    <div><dt>{c.term}</dt><dd>{c.detail}</dd></div>
  ))}
</dl>
<h3 class="clients-h">Mr Mudau has acted for clients including</h3>
<ul class="clients">
  {clients.map((c) => <li>{c}</li>)}
</ul>

<style>
  .creds { display: grid; grid-template-columns: 1fr 1fr; border-top: 1px solid #444; }
  .creds div { padding: 1.1rem 1rem 1.1rem 0; border-bottom: 1px solid #444; }
  .creds dt { font-family: var(--serif); font-size: var(--step-1); color: var(--paper); }
  .creds dd { margin-top: 0.25rem; font-size: var(--step--1); color: #b9bcbf; }
  .clients-h { margin-top: 2.25rem; font-family: var(--sans); font-size: var(--step--1); font-weight: 600; color: #b9bcbf; }
  .clients { list-style: none; padding: 0; margin-top: 0.75rem; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .clients li { border: 1px solid #555; padding: 0.35rem 0.75rem; font-size: var(--step--1); border-radius: 2px; color: var(--paper); }
  @media (max-width: 34rem) { .creds { grid-template-columns: 1fr; } }
</style>
