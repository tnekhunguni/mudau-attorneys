---
import { steps } from '../data/site';
---
<ol class="steps">
  {steps.map((s) => (
    <li>
      <h3>{s.title}</h3>
      <p>{s.body}</p>
    </li>
  ))}
</ol>

<style>
  .steps { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 2rem; counter-reset: step; }
  .steps li { counter-increment: step; border-top: 1px solid var(--ink); padding-top: 1.1rem; }
  .steps li::before {
    content: counter(step);
    display: block;
    font-family: var(--serif);
    font-size: var(--step-4);
    line-height: 1;
    color: var(--red-ink);
    margin-bottom: 0.9rem;
  }
  .steps h3 { margin-bottom: 0.5rem; }
  .steps p { color: var(--graphite); font-size: var(--step--1); line-height: 1.6; }
  @media (max-width: 64rem) { .steps { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 34rem) { .steps { grid-template-columns: 1fr; } }
</style>
