---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ActionBar from '../components/ActionBar.astro';
import { firm } from '../data/site';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  schema?: Record<string, unknown>[]; // extra JSON-LD blocks for this page
}
const { title, description, image = '/og-image.jpg', type = 'website', schema: extra = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, firm.url).href;
// Review builds (PUBLIC_REVIEW=1) are hidden from search engines
const review = import.meta.env.PUBLIC_REVIEW === '1';
// Cookie-free visitor statistics (Cloudflare Web Analytics). Off unless a token is set at build time.
const analyticsToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'LegalService',
  '@id': `${firm.url}/#firm`,
  name: firm.name,
  url: firm.url,
  logo: `${firm.url}/apple-touch-icon.png`,
  image: `${firm.url}/og-image.jpg`,
  hasMap: firm.mapUrl,
  sameAs: firm.profiles.length ? firm.profiles : undefined,
  email: firm.email,
  telephone: '+27150231380',
  slogan: firm.tagline,
  address: {
    '@type': 'PostalAddress',
    streetAddress: firm.address.street,
    addressLocality: firm.address.locality,
    addressRegion: firm.address.region,
    postalCode: firm.address.postalCode,
    addressCountry: firm.address.country,
  },
  areaServed: [{ '@type': 'AdministrativeArea', name: 'Limpopo' }, { '@type': 'Country', name: 'South Africa' }],
  openingHours: 'Mo-Fr 08:00-16:30',
  founder: { '@id': `${firm.url}/#director` },
  employee: { '@id': `${firm.url}/#director` },
};

const director = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${firm.url}/#director`,
  name: firm.director,
  honorificPrefix: 'Mr',
  jobTitle: 'Director and Attorney',
  worksFor: { '@id': `${firm.url}/#firm` },
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'University of Venda' },
    { '@type': 'EducationalOrganization', name: 'Polokwane School for Legal Practice' },
  ],
  memberOf: { '@type': 'Organization', name: 'Black Lawyers Association' },
  url: `${firm.url}/about/`,
};
---
<!doctype html>
<html lang="en-ZA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#000000" />
    {review && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={firm.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, firm.url).href} />
    <meta property="og:locale" content="en_ZA" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <script type="application/ld+json" set:html={JSON.stringify(director)} />
    {extra.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <ActionBar />
    {analyticsToken && !review && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: analyticsToken })}
      />
    )}
  </body>
</html>
