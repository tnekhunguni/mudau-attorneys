---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
---
<Base title="Page not found | Mudau Makondelele Attorneys" description="The page you were looking for could not be found.">
  <PageHeader
    title="Page not found"
    lede="The page may have moved when we updated our website. Try one of these instead."
  >
    <div class="links">
      <a class="btn btn-red" href="/">Home</a>
      <a class="btn btn-line" href="/practice-areas/">Practice areas</a>
      <a class="btn btn-line" href="/contact/">Contact us</a>
    </div>
  </PageHeader>
</Base>
<style>
  .links { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
</style>
