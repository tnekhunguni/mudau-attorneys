---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import InsightList from '../../components/InsightList.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getInsights } from '../../data/insights';

const articles = await getInsights();
---
<Base
  title="Insights | Mudau Makondelele Attorneys, Thohoyandou, Limpopo"
  description="Plain-language articles on South African law from Mudau Makondelele Attorneys: labour disputes, Road Accident Fund claims, criminal and civil litigation and more."
>
  <PageHeader
    title="Insights"
    lede="Short, plain-language guides to the legal questions our clients ask most often."
    crumbs={[]}
  />
  <section class="section">
    <div class="wrap">
      {articles.length > 0
        ? <InsightList items={articles} level={2} />
        : <p>New articles are on their way. In the meantime, call us with your question.</p>}
    </div>
  </section>
  <CtaBand />
</Base>
