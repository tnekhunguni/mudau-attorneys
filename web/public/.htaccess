# mudauattorneys.com (Apache / cPanel)

ErrorDocument 404 /404.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS and the bare domain
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://mudauattorneys.com%{REQUEST_URI} [R=301,L]

  # Old static-site addresses -> new pages (keeps Google results and shared links working)
  RewriteCond %{THE_REQUEST} \s/index\.html[\s?]
  RewriteRule ^index\.html$ / [R=301,L]
  RewriteRule ^about\.html$ /about/ [R=301,L]
  RewriteRule ^services\.html$ /practice-areas/ [R=301,L]
  RewriteRule ^contact\.html$ /contact/ [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000"

  # Fingerprinted build assets never change: cache for a year
  <FilesMatch "\.(webp|woff2|css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
